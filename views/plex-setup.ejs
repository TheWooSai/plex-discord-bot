<!DOCTYPE html>
<html>
<head>
  <title>Plex Discord Bot - Plex Integration</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="sidebar">
    <h2>Plex Discord Bot</h2>
    <a href="/">Dashboard</a>
    <a href="/roles">Role Mappings</a>
    <a href="/plex-setup" class="active">Plex Integration</a>
    <a href="/discord-setup">Discord Bot</a>
    <a href="/settings">Settings</a>
    <a href="/logs">Logs</a>
    <a href="/logout">Logout</a>
  </div>
  <main>
    <h1>Plex Integration</h1>
    
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="success"><%= success %></div>
    <% } %>
    
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    
    <div class="wizard-step">
      <h2>Connect with Plex</h2>
      <p>Click the button below to authenticate with Plex and connect your server:</p>
      <a href="/plex-oauth" class="btn">Connect with Plex OAuth</a>
    </div>
  </main>
</body>
</html>