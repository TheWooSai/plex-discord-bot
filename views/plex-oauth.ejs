<!DOCTYPE html>
<html>
<head>
  <title>Plex Discord Bot - Plex OAuth</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav>
    <a href="/">Dashboard</a>
    <a href="/plex-setup">Plex Setup</a>
    <a href="/logout">Logout</a>
  </nav>
  <main>
    <h1>Plex OAuth Authentication</h1>
    
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="success"><%= success %></div>
    <% } %>
    
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    
    <% if (typeof pin !== 'undefined' && typeof url !== 'undefined') { %>
      <h2>Step 1: Visit the Plex Authorization Page</h2>
      <p>Click the link below to authorize this application to access your Plex account:</p>
      <p><a href="<%= url %>" target="_blank" class="btn">Authorize on Plex</a></p>
      
      <h2>Step 2: Enter the PIN</h2>
      <p>Enter this PIN on the Plex authorization page:</p>
      <div class="pin-display"><%= pin %></div>
      
      <p>After authorizing, you will be redirected back here automatically.</p>
    <% } else { %>
      <p>Click the button below to start the Plex OAuth process:</p>
      <form action="/plex-oauth" method="GET">
        <button type="submit" class="btn">Connect with Plex</button>
      </form>
    <% } %>
  </main>
</body>
</html>