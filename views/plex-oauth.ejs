<!DOCTYPE html>
<html>
<head>
  <title>Plex Discord Bot - Plex OAuth</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="sidebar">
    <h2>Plex Discord Bot</h2>
    <a href="/">Dashboard</a>
    <a href="/roles">Role Mappings</a>
    <a href="/plex-setup" class="active">Plex Integration</a>
    <a href="/discord-setup">Discord Bot</a>
    <a href="/logs">Logs</a>
    <a href="/logout">Logout</a>
  </div>
  <main>
    <h1>Plex OAuth Authentication</h1>
    
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="success"><%= success %></div>
    <% } %>
    
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    
    <% if (typeof pin !== 'undefined' && typeof url !== 'undefined') { %>
      <div class="wizard-step">
        <h2>Step 1: Visit the Plex Authorization Page</h2>
        <p>Click the link below to authorize this application to access your Plex account:</p>
        <p><a href="<%= url %>" target="_blank" class="btn">Authorize on Plex</a></p>
      </div>
      
      <div class="wizard-step">
        <h2>Step 2: Enter the PIN</h2>
        <p>Enter this PIN on the Plex authorization page:</p>
        <div class="pin-display"><%= pin %></div>
        <p id="poll-status">Waiting for authorization...</p>
      </div>
    <% } else { %>
      <div class="wizard-step">
        <p>Click the button below to start the Plex OAuth process:</p>
        <a href="/plex-oauth" class="btn">Connect with Plex</a>
      </div>
    <% } %>
  </main>
  
  <% if (typeof pin !== 'undefined') { %>
  <script>
    let polling = true;
    
    function pollAuthorization() {
      if (!polling) return;
      
      fetch('/plex-oauth/poll')
        .then(response => response.json())
        .then(data => {
          if (data.status === 'success') {
            document.getElementById('poll-status').textContent = 'Authorized! Redirecting...';
            window.location.href = data.redirect;
          } else if (data.status === 'expired') {
            document.getElementById('poll-status').textContent = 'PIN expired. Please try again.';
            polling = false;
          } else if (data.status === 'error') {
            document.getElementById('poll-status').textContent = 'Error: ' + data.message;
            polling = false;
          } else {
            // Still pending
            setTimeout(pollAuthorization, 2000);
          }
        })
        .catch(err => {
          console.error('Poll error:', err);
          setTimeout(pollAuthorization, 2000);
        });
    }
    
    // Start polling
    setTimeout(pollAuthorization, 2000);
  </script>
  <% } %>
</body>
</html>