<!DOCTYPE html>
<html>
<head>
  <title>Plex Discord Bot - Select Libraries</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="sidebar">
    <h2>Plex Discord Bot</h2>
    <a href="/">Dashboard</a>
    <a href="/roles">Role Mappings</a>
    <a href="/plex-setup" class="active">Plex Integration</a>
    <a href="/discord-setup">Discord Bot</a>
    <a href="/settings">Settings</a>
    <a href="/logs">Logs</a>
    <a href="/logout">Logout</a>
  </div>
  <main>
    <h1>Manage Libraries</h1>
    
    <% if (typeof saved !== 'undefined' && saved === 'true') { %>
      <div class="success">Library settings saved!</div>
    <% } %>
    
    <div class="success">Connected to Plex server "<%= server.name %>"!</div>
    
    <form action="/plex-libraries/save" method="POST">
      <input type="hidden" name="serverId" value="<%= server.clientIdentifier || server.id %>">
      
      <table class="library-table">
        <thead>
          <tr>
            <th>Library</th>
            <th>Role Assignment</th>
          </tr>
        </thead>
        <tbody>
          <% libraries.forEach(function(lib) { %>
            <tr>
              <td><%= lib.title %></td>
              <td>
                <label class="role-option"><input type="radio" name="role_<%= lib.key %>" value="managed" checked> Managed</label>
                <label class="role-option"><input type="radio" name="role_<%= lib.key %>" value="do_not_add"> Do Not Add</label>
                <label class="role-option"><input type="radio" name="role_<%= lib.key %>" value="do_not_remove"> Do Not Remove</label>
                <label class="role-option"><input type="radio" name="role_<%= lib.key %>" value="do_not_add_remove"> Do Not Add/Remove</label>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      
      <button type="submit">Save Settings</button>
    </form>
    
    <p><a href="/plex-server-select">Change Server</a></p>
  </main>
</body>
</html>